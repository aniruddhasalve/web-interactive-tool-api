# AWS Bedrock integration for /v1/agent/tasks
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# AWS credentials (leave blank to use IAM role / environment / ~/.aws/credentials)
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_SESSION_TOKEN=

# Optional browser/service settings
CHROMIUM_EXECUTABLE_PATH=
ARTIFACT_DIR=/artifacts
MAX_SITES_PER_JOB=5
DEFAULT_TIMEOUT_SECONDS=30
MAX_AGENT_STEPS=160
MAX_AGENT_TIMEOUT_SECONDS=600
DEFAULT_REQUIRE_CONFIRMATION=true
BROWSER_PROFILE_DIR=/browser-profile
BROWSER_HEADLESS=true
AGENT_FILE_DIR=/agent-files
MAX_UPLOAD_BYTES=52428800
ALLOW_PRIVATE_URLS=false
PRIVATE_URL_ALLOWLIST=
